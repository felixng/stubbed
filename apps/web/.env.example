# Copy to .env.local for local development. Set the same names in Vercel.

# Supabase → Project Settings → API. Both are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google's web OAuth client (the one Supabase's Google provider uses), for
# Google's sign-in popup (#179), so Google names getstubbed.app rather than
# the Supabase project. The secret is server-only: it trades the popup's code
# for Google's ID token. Either unset: the redirect flow through Supabase.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Server-only AI keys for photo show detection (#14).
# With neither set the log form still works, just without suggestions. Never
# prefix with NEXT_PUBLIC_. By default Claude Opus 5.5 is tried first and
# Claude Haiku 5.5 is the fallback when Opus fails or can't name the show,
# so only ANTHROPIC_API_KEY is needed. See src/lib/ai/index.ts.
# ANTHROPIC_API_KEY=
# Optional other providers, used only when named in AI_MODELS below (or
# picked one at a time on the import screen).
# GROQ_API_KEY=
# Gemini takes photos and can search Google; Cerebras takes photos too.
# Groq and Cerebras pick their default model from what they currently serve.
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=

# Optional: which models to try, in order ("provider" or "provider:model").
# Providers: groq, anthropic, gemini, cerebras.
# AI_MODELS applies to every task; AI_MODELS_IDENTIFY overrides it for photos,
# AI_MODELS_EMAIL for ticket emails (text only, so any model works there,
# e.g. cerebras:gpt-oss-120b).
# The import screen (/app/import) can also pick one provider per run.
# AI_MODELS=anthropic:claude-opus-5-5,anthropic:claude-haiku-5-5
# AI_MODELS_IDENTIFY=groq:qwen/qwen3.6-27b,anthropic:claude-opus-5-5

# Public origin for canonical links, Open Graph and the sitemap. Optional: on
# Vercel it falls back to the production domain. Set it once there's a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Analytics 4 for the public pages, cookieless (consent stays
# denied). GA → Admin → Data streams → Web → Measurement ID. Set it for
# Production only in Vercel so previews and local dev send nothing.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# Public half only; private VAPID key belongs in Edge Function secrets.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
