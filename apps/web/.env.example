# Copy to .env.local for local development. Set the same names in Vercel.

# Supabase → Project Settings → API. Both are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google's web OAuth client (the one Supabase's Google provider uses), for
# Google's sign-in popup (#179), so Google names getstubbed.app rather than
# the Supabase project. The secret is server-only: it trades the popup's code
# for Google's ID token. Either unset: the redirect flow through Supabase.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public origin for canonical links, Open Graph and the sitemap. Optional: on
# Vercel it falls back to the production domain. Set it once there's a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Analytics 4 for the public pages, cookieless (consent stays
# denied). GA → Admin → Data streams → Web → Measurement ID. Set it for
# Production only in Vercel so previews and local dev send nothing.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# Public half only; private VAPID key belongs in Edge Function secrets.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional public-copy CMS. Without a project ID, repository copy is used.
# See docs/CMS.md for project creation, content seeding, CORS and webhooks.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# Server-only Viewer token for authenticated draft preview. Never NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=
# Server-only secret matching the Sanity publish webhook's signing secret.
# SANITY_REVALIDATE_SECRET=
# SANITY_API_WRITE_TOKEN is only needed temporarily for pnpm cms:seed;
# do not add it to Vercel or commit it.

# Pro billing (#259), all server-only; never NEXT_PUBLIC_. Any one missing: /api/billing/* answers
# 503 and nothing else changes. See docs/PAYWALL.md.
# Supabase → Project Settings → API → secret key. Bypasses RLS; only lib/billing uses it.
# SUPABASE_SECRET_KEY=
# RevenueCat → Project settings → API keys → secret key (v1).
# REVENUECAT_SECRET_API_KEY=
# The Authorization header value RevenueCat sends with webhooks.
# REVENUECAT_WEBHOOK_AUTH=
# Vercel sends this as a Bearer token to cron routes.
# CRON_SECRET=

# RevenueCat Web Billing public key (#468): public by design, empty until the owner creates it
# (Pro launch epic). Empty: the web paywall says "Upgrades aren't available yet".
# NEXT_PUBLIC_REVENUECAT_WEB_BILLING_KEY=
